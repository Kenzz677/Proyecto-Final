<!DOCTYPE html>
<html lang="es">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Mi Bitácora</title>

<style>

/* =========================
   CONFIGURACIÓN GENERAL
========================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{

    font-family:Arial, Helvetica, sans-serif;

    min-height:100vh;

    background:
        radial-gradient(circle at top left, #7126bb 0%, transparent 35%),
        radial-gradient(circle at bottom right, #100662 0%, transparent 40%),
        linear-gradient(135deg,#09001f,#16004a,#25006b);

    color:white;

}


/* =========================
   ENCABEZADO
========================= */

header{

    text-align:center;

    padding:70px 20px 50px;

    background:rgba(0,0,0,0.25);

    border-bottom:1px solid rgba(255,255,255,0.15);

    backdrop-filter:blur(10px);

}

header h1{

    font-size:clamp(35px,6vw,65px);

    font-weight:900;

    letter-spacing:2px;

    text-transform:uppercase;

    text-shadow:
        0 0 10px #fff,
        0 0 25px #7126bb,
        0 0 45px #7126bb;

    margin-bottom:15px;

}

header p{

    font-size:18px;

    color:#ddd;

}


/* =========================
   CONTENEDOR
========================= */

main{

    width:90%;

    max-width:1200px;

    margin:40px auto;

}


/* =========================
   PESTAÑAS
========================= */

.tabs{

    display:flex;

    justify-content:center;

    flex-wrap:wrap;

    gap:12px;

    margin-bottom:30px;

}

button{

    border:none;

    padding:14px 22px;

    border-radius:12px;

    background:rgba(255,255,255,0.08);

    color:white;

    font-size:15px;

    font-weight:bold;

    cursor:pointer;

    border:1px solid rgba(255,255,255,0.15);

    backdrop-filter:blur(10px);

    transition:all .3s ease;

}

button:hover{

    transform:translateY(-4px);

    background:#7126bb;

    box-shadow:
        0 8px 25px rgba(113,38,187,.5);

}

button.active{

    background:linear-gradient(135deg,#7126bb,#a73cff);

    box-shadow:
        0 0 20px rgba(167,60,255,.6);

}


/* =========================
   PESTAÑAS
========================= */

.tab{

    display:none;

    animation:aparecer .5s ease;

}

.tab.active{

    display:block;

}


@keyframes aparecer{

    from{

        opacity:0;

        transform:translateY(20px);

    }

    to{

        opacity:1;

        transform:translateY(0);

    }

}


/* =========================
   TARJETA
========================= */

.card{

    min-height:350px;

    padding:45px;

    border-radius:25px;

    background:rgba(255,255,255,0.08);

    border:1px solid rgba(255,255,255,0.15);

    backdrop-filter:blur(15px);

    box-shadow:
        0 20px 50px rgba(0,0,0,.35);

    position:relative;

    overflow:hidden;

}


.card::before{

    content:"";

    position:absolute;

    width:200px;

    height:200px;

    background:#7126bb;

    filter:blur(100px);

    opacity:.35;

    top:-80px;

    right:-80px;

}


.card h2{

    font-size:32px;

    margin-bottom:20px;

    position:relative;

}


.card p{

    color:#ddd;

    font-size:17px;

    line-height:1.7;

    position:relative;

}


/* =========================
   ICONO CENTRAL
========================= */

.icon{

    width:90px;

    height:90px;

    margin:20px auto 30px;

    border-radius:50%;

    display:flex;

    justify-content:center;

    align-items:center;

    font-size:40px;

    background:linear-gradient(
        135deg,
        #7126bb,
        #a73cff
    );

    box-shadow:
        0 0 30px rgba(167,60,255,.6);

}


/* =========================
   FOOTER
========================= */

footer{

    margin-top:80px;

    padding:25px;

    text-align:center;

    background:rgba(0,0,0,.35);

    border-top:1px solid rgba(255,255,255,.1);

    color:#ccc;

}

footer strong{

    color:#a73cff;

}


/* =========================
   RESPONSIVE
========================= */

@media(max-width:768px){

    header{

        padding:50px 15px 40px;

    }

    main{

        width:94%;

        margin:25px auto;

    }

    .tabs{

        display:grid;

        grid-template-columns:1fr 1fr;

    }

    button{

        width:100%;

        padding:13px 8px;

    }

    .card{

        padding:30px 20px;

        min-height:300px;

    }

    .card h2{

        font-size:25px;

    }

}

@media(max-width:450px){

    .tabs{

        grid-template-columns:1fr;

    }

}


/* =========================
   BARRA DE DESPLAZAMIENTO
========================= */

::-webkit-scrollbar{

    width:8px;

}

::-webkit-scrollbar-track{

    background:#09001f;

}

::-webkit-scrollbar-thumb{

    background:#7126bb;

    border-radius:10px;

}

</style>

</head>


<body>


<header>

<h1>Mi Bitácora</h1>

<p>Mi espacio para presentar mis proyectos y trabajos</p>

</header>


<main>


<!-- =========================
     BOTONES
========================= -->

<div class="tabs">

<button class="active" onclick="openTab('s1',this)">
📘 Pestaña 1
</button>

<button onclick="openTab('s2',this)">
💻 Pestaña 2
</button>

<button onclick="openTab('s3',this)">
⚡ Pestaña 3
</button>

<button onclick="openTab('s4',this)">
🔧 Pestaña 4
</button>

<button onclick="openTab('s5',this)">
🚀 Pestaña 5
</button>

<button onclick="openTab('s6',this)">
📡 Pestaña 6
</button>

<button onclick="openTab('s7',this)">
🤖 Pestaña 7
</button>

</div>


<!-- =========================
     CONTENIDO
========================= -->

<div id="s1" class="tab active">

<div class="card">

<div class="icon">📘</div>

<h2>Pestaña 1</h2>

<p>
Aquí puedes colocar el contenido de tu primera sección.
</p>

</div>

</div>


<div id="s2" class="tab">

<div class="card">

<div class="icon">💻</div>

<h2>Pestaña 2</h2>

<p>
Aquí puedes colocar el contenido de tu segunda sección.
</p>

</div>

</div>


<div id="s3" class="tab">

<div class="card">

<div class="icon">⚡</div>

<h2>Pestaña 3</h2>

<p>
Aquí puedes colocar el contenido de tu tercera sección.
</p>

</div>

</div>


<div id="s4" class="tab">

<div class="card">

<div class="icon">🔧</div>

<h2>Pestaña 4</h2>

<p>
Aquí puedes colocar el contenido de tu cuarta sección.
</p>

</div>

</div>


<div id="s5" class="tab">

<div class="card">

<div class="icon">🚀</div>

<h2>Pestaña 5</h2>

<p>
Aquí puedes colocar el contenido de tu quinta sección.
</p>

</div>

</div>


<div id="s6" class="tab">

<div class="card">

<div class="icon">📡</div>

<h2>Pestaña 6</h2>

<p>
Aquí puedes colocar el contenido de tu sexta sección.
</p>

</div>

</div>


<div id="s7" class="tab">

<div class="card">

<div class="icon">🤖</div>

<h2>Pestaña 7</h2>

<p>
Aquí puedes colocar el contenido de tu séptima sección.
</p>

</div>

</div>


</main>


<footer>

<p>
Hecho por <strong>@kenzz</strong>
</p>

</footer>


<script>

function openTab(id,btn){

    document
    .querySelectorAll('.tab')
    .forEach(tab => {
        tab.classList.remove('active');
    });


    document
    .querySelectorAll('button')
    .forEach(button => {
        button.classList.remove('active');
    });


    document
    .getElementById(id)
    .classList.add('active');


    btn.classList.add('active');

}

</script>


</body>

</html>
