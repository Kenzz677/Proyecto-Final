        .tabs {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 30px;
        }

        .tab-btn {
            border: none;
            padding: 12px 18px;
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.08);
            color: white;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            border: 1px solid rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            transition: all .3s ease;
        }

        .tab-btn:hover {
            transform: translateY(-3px);
            background: #7126bb;
            box-shadow: 0 8px 25px rgba(113, 38, 187, .5);
        }

        .tab-btn.active {
            background: linear-gradient(135deg, #7126bb, #a73cff);
            box-shadow: 0 0 20px rgba(167, 60, 255, .6);
            border-color: rgba(255, 255, 255, 0.4);
        }

        /* =========================
           CONTENIDO Y TARJETAS
        ========================= */
        .tab {
            display: none;
            animation: aparecer .5s ease;
        }

        .tab.active {
            display: block;
        }

        @keyframes aparecer {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .card {
            min-height: 350px;
            padding: 40px;
            border-radius: 25px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(15px);
            box-shadow: 0 20px 50px rgba(0, 0, 0, .35);
            position: relative;
            overflow: hidden;
        }

        .card::before {
            content: "";
            position: absolute;
            width: 200px;
            height: 200px;
            background: #7126bb;
            filter: blur(100px);
            opacity: .35;
            top: -80px;
            right: -80px;
        }

        .card h2 {
            font-size: 28px;
            margin-bottom: 20px;
            position: relative;
            color: #fff;
        }

        .card p, .card ul {
            color: #ddd;
            font-size: 16px;
            line-height: 1.7;
            position: relative;
        }

        .card ul {
            list-style: none;
            padding-left: 0;
        }

        .card li {
            margin-bottom: 12px;
            padding-left: 20px;
            position: relative;
        }

        .card li::before {
            content: "•";
            color: #a73cff;
            font-weight: bold;
            font-size: 20px;
            position: absolute;
            left: 0;
            top: -2px;
        }

        .icon {
            width: 80px;
            height: 80px;
            margin: 10px auto 25px;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 36px;
            background: linear-gradient(135deg, #7126bb, #a73cff);
            box-shadow: 0 0 30px rgba(167, 60, 255, .6);
        }

        .video-container {
            margin-top: 20px;
            position: relative;
            width: 100%;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
